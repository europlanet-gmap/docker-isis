# BUILD attributes
# ----------------

# ISIS_VERSION="7.1.0"
# ASP_VERSION="3.2.0"
ISIS_VERSION="8.0.0"
ASP_VERSION="3.3.0" # 3.4.0 is not yet supported in conda channels due to isis 8.0.0+ incompatibilities. 

GISPY_BASE_IMAGE="quay.io/jupyter/scipy-notebook:2025-03-24"
GISPY_IMAGE="gmap/jupyter-gispy:dev"
GISPY_ENV_NAME="gispy"

ISIS_BASE_IMAGE="quay.io/jupyter/minimal-notebook:2025-03-24"
ISIS_IMAGE="gmap/jupyter-isis:dev"
ISIS_ENV_NAME="isis"

ASP_BASE_IMAGE="$ISIS_IMAGE"
ASP_IMAGE="gmap/jupyter-isis-asp:dev"
ASP_ENV_NAME="isis-asp"

ISISASP_GISPY_BASE_IMAGE="$ASP_IMAGE"
ISISASP_GISPY_IMAGE="gmap/jupyter-isis-asp-gispy:dev"
ISISASP340_GISPY_IMAGE="gmap/jupyter-isis-asp340-gispy:dev"
ISISASP_GISPY_ENV_NAME="isis-asp-gispy"

GRASS_BASE_IMAGE="quay.io/jupyter/scipy-notebook:2025-03-24"
GRASS_IMAGE="gmap/jupyter-grass:dev"
GRASS_ENV_NAME="grass"

GISPY_GRASS_BASE_IMAGE="$GISPY_IMAGE"
GISPY_GRASS_IMAGE="gmap/jupyter-gispy-grass:dev"
GISPY_GRASS_ENV_NAME="gispy-grass"

MATISSE_BASE_IMAGE="quay.io/jupyter/scipy-notebook:2025-03-24"
MATISSE_IMAGE="gmap/jupyter-matisse:dev"
MATISSE_ENV_NAME="matisse"
MATISSE_BASE_ENV_NAME='matisse'

GISPY_MATISSE_BASE_IMAGE="$GISPY_IMAGE"
GISPY_MATISSE_IMAGE="gmap/jupyter-matisse-gispy:dev"
GISPY_MATISSE_ENV_NAME="matisse-gispy"
GISPY_MATISSE_BASE_ENV_NAME='matisse'

FORTRAN_BASE_IMAGE="quay.io/jupyter/scipy-notebook:2025-03-24"
FORTRAN_IMAGE="gmap/jupyter-fortran:dev"
FORTRAN_ENV_NAME="fortran"

# ISIS-data directories environment variables in new image
# ------------------
ISISDATA="/mnt/isis/data"
ISISTESTDATA="/mnt/isis/testdata"
